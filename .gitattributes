# UE原生资源
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap filter=lfs diff=lfs merge=lfs -text
*.uplugin filter=lfs diff=lfs merge=lfs -text
*.upk filter=lfs diff=lfs merge=lfs -text

# 美术源文件
*.fbx filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.tga filter=lfs diff=lfs merge=lfs -text
*.psd filter=lfs diff=lfs merge=lfs -text

# 音频、视频
*.wav filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text

# 模型、动画、字体
*.gltf filter=lfs diff=lfs merge=lfs -text
*.otf filter=lfs diff=lfs merge=lfs -text
*.ttf filter=lfs diff=lfs merge=lfs -text

# Raw资源文件夹全部LFS
RawContent/**/* filter=lfs diff=lfs merge=lfs -text

# Preserve archived evidence bytes and the recorded SHA-256 values.
Docs/Stinger/BaselineEvidence/** -text
# Treat preserved Windows line endings as line endings in JSON whitespace checks.
Docs/Stinger/BaselineEvidence/**/*.json whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Runtime logs retain their original whitespace.
Docs/Stinger/BaselineEvidence/**/*.txt -whitespace
